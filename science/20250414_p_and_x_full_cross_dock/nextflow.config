process.executor = 'slurm'
clusterOptions = '--partition=cpu'
executor {
    perCpuMemAllocation = true
    queueSize = 1000
}

conda.enabled = true
conda.useMamba = true
report.overwrite = true
workflow.failOnIgnore = true
params.repoPath = "/data1/choderaj/paynea/asapdiscovery-sars-retrospective/"
params.curatedFragalysis = "/data1/choderaj/paynea/asap-datasets/mpro_fragalysis-04-01-24_curated"
params.fragalysisCache = "/data1/choderaj/paynea/asap-datasets/mpro_fragalysis-04-01-24_curated_cache"
params.ligandFiles = "${params.fragalysisCache}/ligand_files"
params.3dligandFile = "${params.ligandFiles}/combined_3d.sdf"
params.2dligandFile = "${params.ligandFiles}/combined_2d.sdf"
params.split3dligandFiles = "${params.ligandFiles}/split_3d"
params.split2dligandFiles = "${params.ligandFiles}/split_2d"
params.projectDir = "${params.repoPath}/science/20250414_p_and_x_full_cross_dock"
params.scripts = "${params.projectDir}/scripts"
params.loopDB = "/data1/choderaj/asap-playground/rcsb_spruce.loop_db"

// Conda Envs
params.asap = "/home/paynea/miniforge3/envs/asap2025"
params.harbor = "/home/paynea/miniforge3/envs/harbor"

// Add the name of the process as a string and it will turn off caching for that process
params.restart_from = null

// Flags
params.take = -1